<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:background="@drawable/user_list_background"
    android:layout_marginHorizontal="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:padding="12dp"
        android:background="@android:color/transparent"
        android:foreground="@drawable/bg_user_item_ripple">

        <!-- Profile Image -->
        <ImageView
            android:id="@+id/imgProfile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_user"
            android:background="@drawable/circle_background"
            android:contentDescription="User Image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Username -->
        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="Anil Kumar"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#222222"
            app:layout_constraintTop_toTopOf="@id/imgProfile"
            app:layout_constraintBottom_toTopOf="@id/tvLastMessage"
            app:layout_constraintStart_toEndOf="@id/imgProfile"
            app:layout_constraintEnd_toStartOf="@id/tvTime" />

        <!-- Last Message -->
        <TextView
            android:id="@+id/tvLastMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Hey, let's connect!"
            android:textSize="14sp"
            android:textColor="#666666"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/tvUserName"
            app:layout_constraintBottom_toBottomOf="@id/imgProfile"
            app:layout_constraintStart_toStartOf="@id/tvUserName"
            app:layout_constraintEnd_toEndOf="@id/tvUserName" />

        <!-- Time -->
        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:45 PM"
            android:textSize="12sp"
            android:textColor="#999999"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/tvUserName"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Unread Count Badge -->
        <TextView
            android:id="@+id/tvUnreadBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="20dp"
            android:minHeight="20dp"
            android:background="@drawable/bg_unread_badge"
            android:text="2"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:gravity="center"
            android:padding="2dp"
            android:includeFontPadding="false"
            android:lineSpacingExtra="0dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTime"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
