<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Soft gradient background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="1"
                android:startColor="#B2FEFA"
                android:centerColor="#0ED2F7"
                android:endColor="#4CA1AF" />
        </shape>
    </item>

    <!-- Diagonal wave cutting across screen -->
    <item>
        <vector android:width="600dp" android:height="400dp" android:viewportWidth="600" android:viewportHeight="400">
            <path
                android:fillColor="#33FFFFFF"
                android:pathData="M-100,100 Q300,-100 700,300 L700,500 L-100,500 Z"/>
        </vector>
    </item>

    <!-- Curved wave bulging from right edge -->
    <item android:gravity="center|end">
        <vector android:width="400dp" android:height="300dp" android:viewportWidth="400" android:viewportHeight="300">
            <path
                android:fillColor="#22FFFFFF"
                android:pathData="M400,0 Q200,150 400,300 L400,300 L400,0 Z"/>
        </vector>
    </item>

    <!-- Bottom-up wave from bottom-left corner -->
    <item android:gravity="bottom|start">
        <vector android:width="500dp" android:height="300dp" android:viewportWidth="500" android:viewportHeight="300">
            <path
                android:fillColor="#44FFFFFF"
                android:pathData="M0,300 Q250,100 500,300 L500,500 L0,500 Z"/>
        </vector>
    </item>

    <!-- Blobs (same, scattered) -->
    <item android:gravity="top|end">
        <vector android:width="120dp" android:height="120dp" android:viewportWidth="100" android:viewportHeight="100">
            <path android:fillColor="#33FFFFFF" android:pathData="M50,0 C90,30 90,70 50,100 C10,70 10,30 50,0 Z"/>
        </vector>
    </item>

    <item android:gravity="center">
        <vector android:width="140dp" android:height="140dp" android:viewportWidth="100" android:viewportHeight="100">
            <path android:fillColor="#22FFFFFF" android:pathData="M50,0 C85,30 85,70 50,100 C15,70 15,30 50,0 Z"/>
        </vector>
    </item>

    <item android:gravity="bottom|start">
        <vector android:width="100dp" android:height="100dp" android:viewportWidth="100" android:viewportHeight="100">
            <path android:fillColor="#33FFFFFF" android:pathData="M50,0 C80,20 80,80 50,100 C20,80 20,20 50,0 Z"/>
        </vector>
    </item>

</layer-list>
