<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Main rounded bubble -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#DCF8C6" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Tail at bottom-end -->
    <item android:gravity="bottom|end">
        <vector
            android:width="14dp"
            android:height="14dp"
            android:viewportWidth="14"
            android:viewportHeight="14">
            <path
                android:fillColor="#DCF8C6"
                android:pathData="M0,14 Q7,0 14,14 Z"/>
        </vector>
    </item>

</layer-list>
