<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Matching gradient base from full screen -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#B2FEFA"
                android:centerColor="#0ED2F7"
                android:endColor="#4CA1AF" />
        </shape>
    </item>

    <!-- Diagonal wave curve from top-left -->
    <item>
        <vector
            android:width="400dp"
            android:height="100dp"
            android:viewportWidth="400"
            android:viewportHeight="100">
            <path
                android:fillColor="#33FFFFFF"
                android:pathData="M-40,80 Q100,0 400,60 L400,100 L0,100 Z"/>
        </vector>
    </item>

    <!-- Floating blob top-end -->
    <item android:gravity="top|end">
        <vector
            android:width="140dp"
            android:height="140dp"
            android:viewportWidth="100"
            android:viewportHeight="100">
            <path
                android:fillColor="#22FFFFFF"
                android:pathData="M50,0 C90,30 90,70 50,100 C10,70 10,30 50,0 Z"/>
        </vector>
    </item>

</layer-list>
